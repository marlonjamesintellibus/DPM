# Copy to .env.local and fill in. .env.local is ignored by git; this file is the documented template.

# Atlas through OpenRouter (phase 4). Empty means the recorded fixture is used.
OPENROUTER_API_KEY=

# The OpenRouter model name for Atlas. Empty means the default (GPT-6.1 Sol).
OPENROUTER_MODEL=
# The model for a read's last try, and for wording reasons. Empty means Claude Haiku 5.5 (D21).
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_DRAFT_MODEL=

# Optional: Postgres instead of the local PGlite.
# DATABASE_URL=postgres://user:password@localhost:5432/dpm
